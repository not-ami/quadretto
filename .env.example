# Copy to .env and edit. Used by docker-compose.yml (for a manual install, see README).

# Database password (required). Pick a long random one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=

# 1 = anyone who can reach the server can create an account. 0 (default) = accounts only via:
#   docker compose exec app node server/admin.js create-user <name>
ALLOW_SIGNUP=0

# Where Quadretto listens on this computer. Keep 127.0.0.1 and put an HTTPS proxy in front to reach it from other devices.
QUADRETTO_BIND=127.0.0.1
QUADRETTO_PORT=8790

# Optional: your HTTPS address. Visitors of the plain-HTTP address see a banner pointing to it.
HTTPS_URL=

# Optional: IP of the reverse proxy in front of Quadretto (comma-separated), so login limits see real client addresses.
TRUST_PROXY=
